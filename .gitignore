# ============================================================================
#  /blog  (WordPress)
#  Ignore EVERYTHING in blog/ EXCEPT wp-content/themes/hawlast
#  Those two are your own work and stay in version control.
#  WordPress core, wp-content/uploads, cache and wflogs are not tracked.
# ============================================================================

/blog/*
!/blog/wp-content/
/blog/wp-content/*
!/blog/wp-content/themes/
/blog/wp-content/themes/*
!/blog/wp-content/themes/hawlast/


# Exclude environment or runtime logs
.env
*.log
.txt
.md 

# Exclude root config.php (database credentials)
/config.php
